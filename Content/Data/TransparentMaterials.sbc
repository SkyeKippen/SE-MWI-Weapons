<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <TransparentMaterials>
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>MWI_TEC_01_Mk1</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <CanBeAffectedByOtherLights>true</CanBeAffectedByOtherLights>
            <SoftParticleDistanceScale>1</SoftParticleDistanceScale>
            <Texture>Textures\MWI_TEC_01_Mk1_Ammo.dds</Texture>
            <UseAtlas>false</UseAtlas>
            <Color>
                <X>1</X>
                <Y>1</Y>
                <Z>1</Z>
                <W>1</W>
            </Color>
            <ColorAdd>
                <X>0.0</X>
                <Y>0.0</Y>
                <Z>0.0</Z>
                <W>0.0</W>
            </ColorAdd>
            <ShadowMultiplier>
                <X>0</X>
                <Y>0</Y>
                <Z>0</Z>
                <W>4.0</W>
            </ShadowMultiplier>
            <LightMultiplier>
                <X>0.1</X>
                <Y>0.1</Y>
                <Z>0.1</Z>
                <W>0.1</W>
            </LightMultiplier>
            <Reflectivity>0</Reflectivity>
            <Fresnel>0</Fresnel>
            <ReflectionShadow>1</ReflectionShadow>
            <Gloss>1</Gloss>
            <GlossTextureAdd>0</GlossTextureAdd>
            <SpecularColorFactor>1</SpecularColorFactor>
        </TransparentMaterial>
    </TransparentMaterials>
</Definitions>
